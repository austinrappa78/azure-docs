{
  "version": 1,
  "repoId": "azure-docs",
  "metadataSchema": [
    {
      "key": "title",
      "label": "Title",
      "type": "string",
      "required": true
    },
    {
      "key": "owner",
      "label": "Owner",
      "type": "string",
      "required": true
    },
    {
      "key": "type",
      "label": "Topic Type",
      "type": "string",
      "required": true,
      "allowedValues": [
        "concept",
        "task",
        "reference",
        "troubleshooting"
      ],
      "description": "DITA topic type: concept (explanations/architecture), task (ordered procedures/how-tos), reference (APIs/schemas/tables), or troubleshooting (diagnosing and resolving a specific problem — condition, cause, and remedy)."
    },
    {
      "key": "journeyStage",
      "label": "Journey Stage",
      "type": "string",
      "required": true,
      "description": "Where in the customer journey this topic sits (e.g. Evaluate, Plan, Build, Maintain). The organization's stage names are managed on the Content Gaps page, not here — this field just carries the value per topic."
    },
    {
      "key": "useCases",
      "label": "Use Cases",
      "type": "string-list",
      "required": true,
      "description": "Which of this project's defined use cases this topic covers (see the project's Content Gaps page). Drives the demand-side coverage matrix — a topic with no use case tag is invisible to it."
    },
    {
      "key": "audience",
      "label": "Audience",
      "type": "string",
      "required": true
    },
    {
      "key": "platform",
      "label": "Platform",
      "type": "string",
      "required": true
    }
  ],
  "includePaths": [],
  "prePushValidation": true,
  "sourceLinkBases": {
    "ticket": "https://rappadev.atlassian.net",
    "commit": "https://github.com/austinrappa78/azure-docs",
    "pr": "https://github.com/austinrappa78/azure-docs"
  },
  "severities": {
    "unresolved-reference": "error",
    "ambiguous-key-reference": "error",
    "duplicate-key": "error",
    "transclusion-cycle": "error",
    "parse-error": "error",
    "missing-metadata": "error",
    "sentinel-metadata": "error",
    "invalid-metadata-value": "error",
    "stale-agents-rules": "warning",
    "banned-term": "error",
    "path-reference-used": "warning",
    "dangling-image-reference": "error",
    "dangling-xref-reference": "error",
    "dangling-conref-reference": "error",
    "incompatible-conref-target": "error",
    "mdita-profile-violation": "error"
  },
  "journeyStages": [
    {
      "name": "Evaluate",
      "description": ""
    },
    {
      "name": "Plan",
      "description": ""
    },
    {
      "name": "Build",
      "description": ""
    },
    {
      "name": "Maintain",
      "description": ""
    }
  ],
  "useCases": [],
  "outputDirectory": "out",
  "documentationFormat": "microsoft-learn",
  "defaultTopicDirectory": "topics",
  "defaultImageDirectory": "images"
}
